# Bedrock Flow - deployment config
# Copy to config/local.env and edit. Never commit local.env.

BF_ROOT=/opt/bedrock-flow
BF_STATE=$BF_ROOT/state
BF_SLOTS=$BF_ROOT/slots

# A clean extracted BDS folder, cloned per slot
BF_BDS_SRC=$BF_ROOT/bds

# Slot definitions: name:game_port:world
BF_SLOTS_DEF="A:20031:bot-world B:20041:dsh-test C:20051:spare-world"

# Reaper thresholds (minutes)
BF_REAP_IDLE_MIN=30
BF_REAP_CLAIM_MIN=60
BF_RSS_MIN_KB=50000

# Bot runtime
BF_NETBOT=$BF_ROOT/tools/bf-netbot.js
BF_MC_VERSION=1.26.51
